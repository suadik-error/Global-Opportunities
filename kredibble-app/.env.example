# Local development can be left blank to use platform defaults.
# For a physical phone in development, set this to your computer LAN IP, for example:
# EXPO_PUBLIC_API_URL=http://192.168.1.25:4000/api
#
# Production builds must set this to the deployed HTTPS backend API URL, for example:
# EXPO_PUBLIC_API_URL=https://api.your-domain.com/api
EXPO_PUBLIC_API_URL=
