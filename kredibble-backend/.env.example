NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Local MongoDB database. Keep DATABASE_URL in sync with these values.
MONGODB_ROOT_USERNAME=mongodb_root_user_placeholder
MONGODB_ROOT_PASSWORD=mongodb_root_password_placeholder
MONGODB_DATABASE=kredibble
MONGODB_PORT=27017
DATABASE_URL="mongodb://mongodb_root_user_placeholder:mongodb_root_password_placeholder@localhost:27017/kredibble?authSource=admin"

JWT_SECRET=jwt_secret_placeholder
ADMIN_JWT_SECRET=admin_jwt_secret_placeholder
STORAGE_BUCKET=kredibble-local
STORAGE_ACCESS_KEY=storage_access_key_placeholder
STORAGE_SECRET_KEY=storage_secret_key_placeholder
